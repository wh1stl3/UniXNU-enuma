# Candidate generic 4 KiB entry configuration, not a boot-tested board config.
# Board remains example=true until firmware/ADT/link contracts are reviewed.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
# Upstream boot-progress requires UFS/owner-root/Virtio archives not reviewed here.
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
# Enable storage/display only after SM8250 clock/PHY/SMMU/UEFI handoff audits.
# stage6 RamBlock 内存根（rd=md0-ramblock）：RAM 盘经 IOBlockStorageDevice->IOMedia->APFS 挂载 restore ramdisk。
# 依赖 CONFIG_XNU_NATIVE_AES（arch 片段 common.config 已给）与 CONFIG_XNU_SOURCE_MOCKFS（OS 片段 ipados.config 已给）。
CONFIG_XNU_NATIVE_RAM_BLOCK=y
