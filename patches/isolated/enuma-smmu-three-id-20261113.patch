+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef UFS_THREE_ID_DIAGNOSTIC_H
+#define UFS_THREE_ID_DIAGNOSTIC_H
+#include "UfsObservationContract.h"
+#include "UfsReuseAdmission.h"
+#include "UfsObservedSmmuCapture.h"
+#ifndef NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC
+#define NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC 0
+#endif
+#if NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC != 0 && NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC != 1
+#error NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC must be 0 or 1
+#endif
+namespace UfsObservation {
+static constexpr unsigned threeIdPolicyVersion=0x20261113;
+// Caller-owned identity, deliberately not an ObservationContext address or a claim.
+static constexpr uint64_t threeIdSession=0x454e554d41334944ULL;
+static constexpr Binding threeIdBinding {true,true,false,UfsPlatform::Soc::Sm8250,
+  0x1d84000,0x3000,UfsPlatform::Policy::None,0x15000000,0xd0000,threeIdPolicyVersion};
+// Exact board compatible list from enuma.dts. This selects hardware, NOT FD identity.
+static inline bool threeIdBoard(UfsPlatform::Bytes b) {
+  static const char compatible[]="xiaomi,enuma\0qcom,sm8250";
+  if (!b.data || b.size!=sizeof(compatible)) return false;
+  const auto *p=static_cast<const char *>(b.data);
+  for (size_t i=0;i<sizeof(compatible);++i) if (p[i]!=compatible[i]) return false;
+  return true;
+}
+struct ThreeIdIssuer final {
+  static Issuance issue(const Binding &b,uint64_t session,Level requested,
+                        UfsPlatform::Bytes board,UfsReuse::AccessProfile p) {
+#if NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC
+    const UfsPlatform::Resources r {b.recognized,b.diagnosticSupported,b.takeoverSupported,
+      b.soc,b.hcBase,b.hcSize,b.policy};
+    if (!threeIdBoard(board) || !sameBinding(b,threeIdBinding) ||
+        !UfsReuse::validateProfileShape(r,p).valid) return {Result::BadResource,nullptr};
+    if (session!=threeIdSession) return {Result::NoSession,nullptr};
+    if (requested!=Level::IdsOnly) return {Result::NoAccessPolicy,nullptr};
+    // One global claim in NativeUfs's sole issuer TU, across all service instances.
+    // Never reset; consumed even if the subsequent map fails.
+    static unsigned claimed;
+    if (__atomic_exchange_n(&claimed,1U,__ATOMIC_ACQ_REL)) return {Result::NoSession,nullptr};
+    static constexpr ObservationContext context(threeIdBinding,threeIdSession,
+      Level::IdsOnly,Level::IdsOnly,0,0,0);
+    return {Result::Ok,&context};
+#else
+    (void)board; (void)p;
+    return production(b,session,requested);
+#endif
+  }
+};
+}
+namespace UfsThreeId {
+// Register offset facts: Linux v6.1 arm-smmu/arm-smmu.h, local fixed copy
+// .cache/ufs-hci30-compat-20261111/ref/drivers_iommu_arm_arm-smmu_arm-smmu.h
+// lines 44-72: ARM_SMMU_GR0_ID0/ID1/ID2, architected v1/v2 GR0 IDs.
+// Applies to the selected qsmmu-v500 v2 GR0; NOT evidence of CPU access permission.
+static constexpr unsigned offsets[3]={0x20,0x24,0x28};
+struct Report {
+  unsigned completed_count=0;
+  uint32_t raw[3]={};
+  ObservedSmmu::Status decode_status=ObservedSmmu::Status::Unknown;
+};
+// No callback-failure recovery: a real MMIO abort does not return here.
+// Caller performs ALL admission and mapping before entering this bounded reader.
+template<class Load> static void read(Load &load,ObservedSmmuCapture::Breadcrumb &b,Report &r) {
+  r={0,{0,0,0},ObservedSmmu::Status::Unknown};
+  for (unsigned i=0;i<3;++i) {
+    b.completed=0; b.sample=0; b.domain=1; b.stage=1; b.offset=offsets[i]; b.attempted=1;
+    ObservedSmmuCapture::barrier();
+    r.raw[i]=load(offsets[i]);
+    ObservedSmmuCapture::barrier();
+    r.completed_count=i+1; b.completed=1; ObservedSmmuCapture::barrier();
+  }
+  ObservedSmmu::Geometry geometry {};
+  r.decode_status=ObservedSmmu::decodeGeometry({true,r.raw[0]},{true,r.raw[1]},
+    {true,r.raw[2]},0xd0000,128,geometry);
+}
+}
