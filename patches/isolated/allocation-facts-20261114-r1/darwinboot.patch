+/* SPDX-License-Identifier: MIT */
+#ifndef DARWIN_ALLOCATION_FACTS_H
+#define DARWIN_ALLOCATION_FACTS_H
+#include "AllocationFactsUefi.h"
+
+/* Called only after the original strict ADT parser. Append a root property,
+ * not a chosen/memory-map loader range: XNU must never free this backing.
+ * The caller allocates Size+124 bytes, copies the complete old ADT first.
+ */
+static inline EFI_STATUS EnumaAdtInsert(VOID *Tree, UINTN Size,
+                                        CONST ENUMA_ALLOCATION_FACTS *Facts)
+{
+  UINT8 *P = Tree;
+  UINT32 Count;
+  if (Size < 8 || !EnumaFactsValid(Facts,sizeof(*Facts),1))
+    return EFI_COMPROMISED_DATA;
+  CopyMem(&Count,P,4);
+  if (Count == MAX_UINT32) return EFI_COMPROMISED_DATA;
+  /* Insert before old root properties, preserving every child and offset. */
+  CopyMem(P + 8 + 124,P + 8,Size - 8);
+  ZeroMem(P + 8,36);
+  CopyMem(P + 8,ENUMA_FACTS_PROPERTY,sizeof(ENUMA_FACTS_PROPERTY));
+  WriteUnaligned32((UINT32 *)(P + 40),sizeof(*Facts));
+  CopyMem(P + 44,Facts,sizeof(*Facts));
+  WriteUnaligned32((UINT32 *)P,Count + 1);
+  return EFI_SUCCESS;
+}
+
+/* Copy source bytes only after the ENTIRE fixed-size source is BSData.
+ * There is no firmware source pointer in the ADT or returned snapshot. */
+static inline EFI_STATUS EnumaFactsSnapshot(ENUMA_ALLOCATION_FACTS *Out,
+  CONST VOID *Map, UINTN Size, UINTN Stride)
+{
+  CONST ENUMA_ALLOCATION_FACTS *Source = EnumaFindFacts();
+  if (Source == NULL) return EFI_NOT_FOUND;
+  if (!EnumaBsCovered(Map,Size,Stride,(UINTN)Source,sizeof(*Source)))
+    return EFI_COMPROMISED_DATA;
+  CopyMem(Out,Source,sizeof(*Out));
+  return EnumaFactsValid(Out,sizeof(*Out),1) ? EFI_SUCCESS : EFI_COMPROMISED_DATA;
+}
+#endif
