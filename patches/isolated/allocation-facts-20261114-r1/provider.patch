+/* SPDX-License-Identifier: MIT */
+#ifndef ENUMA_ALLOCATION_FACTS_UEFI_H
+#define ENUMA_ALLOCATION_FACTS_UEFI_H
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include "AllocationFacts.h"
+
+/* Private enuma facts GUID, not an ownership/handoff protocol. */
+static EFI_GUID mEnumaFactsGuid =
+  {0x7d94ad23,0xe4da,0x43b4,{0x91,0xa2,0x38,0xf0,0x11,0x57,0x56,0xc1}};
+
+static inline ENUMA_ALLOCATION_FACTS *EnumaFindFacts(VOID)
+{
+  UINTN I;
+  for (I = 0; I < gST->NumberOfTableEntries; ++I)
+    if (CompareMem(&gST->ConfigurationTable[I].VendorGuid,
+                   &mEnumaFactsGuid, sizeof(EFI_GUID)) == 0)
+      return gST->ConfigurationTable[I].VendorTable;
+  return NULL;
+}
+
+/* Every covering descriptor must be BSData. No GCD shortcut, no first-page
+ * test. Map is a current BS snapshot supplied by GetMemoryMap. */
+static inline BOOLEAN EnumaBsCovered(CONST VOID *Map, UINTN Size, UINTN Stride,
+                                     UINT64 Base, UINT64 Bytes)
+{
+  UINT64 Cursor = Base, End;
+  UINTN Offset;
+  if (Stride < sizeof(EFI_MEMORY_DESCRIPTOR) || Size % Stride ||
+      Bytes == 0 || Bytes > MAX_UINT64 - Base) return FALSE;
+  End = Base + Bytes;
+  while (Cursor < End) {
+    UINT64 Next = Cursor;
+    for (Offset = 0; Offset < Size; Offset += Stride) {
+      CONST EFI_MEMORY_DESCRIPTOR *D = (CONST VOID *)((CONST UINT8 *)Map + Offset);
+      UINT64 DBytes;
+      if ((D->PhysicalStart & 4095) ||
+          D->NumberOfPages > (MAX_UINT64 - D->PhysicalStart) / 4096) return FALSE;
+      DBytes = D->NumberOfPages * 4096;
+      if (D->Type == EfiBootServicesData && D->PhysicalStart <= Cursor &&
+          Cursor - D->PhysicalStart < DBytes)
+        Next = D->PhysicalStart + DBytes;
+    }
+    if (Next == Cursor) return FALSE;
+    Cursor = Next;
+  }
+  return TRUE;
+}
+
+static inline BOOLEAN EnumaFactsCovered(CONST ENUMA_ALLOCATION_FACTS *F,
+  CONST VOID *Map, UINTN Size, UINTN Stride, UINT64 Window, UINT64 WindowBytes)
+{
+  UINTN I;
+  if (!EnumaFactsOutsideWindow(F, Window, WindowBytes)) return FALSE;
+  for (I = 0; I < F->Count; ++I)
+    if (!EnumaBsCovered(Map,Size,Stride,F->Ranges[I].Physical,
+                        F->Ranges[I].Pages * 4096)) return FALSE;
+  return TRUE;
+}
+
+/* BSP synchronous BS profile already required by these producers. Each
+ * successful publication is an immutable page-backed snapshot. Old snapshots
+ * are deliberately retained too: no cached configuration-table pointer can
+ * become stale. Successful backing is pinned by the respective caller BEFORE
+ * publication and must never subsequently be freed. No cross-EBS callback.
+ */
+static inline EFI_STATUS EnumaPublishAllocation(UINT32 Kind, UINT64 Physical,
+                                                UINT64 Pages, UINT64 Device)
+{
+  ENUMA_ALLOCATION_FACTS Next = {0}, *Old = EnumaFindFacts();
+  ENUMA_ALLOCATION_RANGE R = {Kind,0,Physical,Pages,Device};
+  EFI_PHYSICAL_ADDRESS Address = 0;
+  EFI_STATUS Status;
+  UINTN I;
+  if (!EnumaRangeValid(&R)) return EFI_INVALID_PARAMETER;
+  if (Old != NULL) {
+    if (!EnumaFactsValid(Old,sizeof(*Old),0)) return EFI_COMPROMISED_DATA;
+    if (Old->Count == 2) return EFI_ALREADY_STARTED;
+    for (I = 0; I < Old->Count; ++I)
+      if (Old->Ranges[I].Kind == Kind) return EFI_ALREADY_STARTED;
+    CopyMem(&Next,Old,sizeof(Next));
+  } else {
+    Next.Magic = ENUMA_FACTS_MAGIC;
+    Next.Version = 1;
+    Next.Bytes = sizeof(Next);
+  }
+  Next.Ranges[Next.Count++] = R;
+  if (!EnumaFactsValid(&Next,sizeof(Next),0)) return EFI_INVALID_PARAMETER;
+  Status = gBS->AllocatePages(AllocateAnyPages,EfiBootServicesData,1,&Address);
+  if (EFI_ERROR(Status)) return Status;
+  CopyMem((VOID *)(UINTN)Address,&Next,sizeof(Next));
+  Status = gBS->InstallConfigurationTable(&mEnumaFactsGuid,(VOID *)(UINTN)Address);
+  if (EFI_ERROR(Status)) {
+    EFI_STATUS Cleanup = gBS->FreePages(Address,1);
+    return EFI_ERROR(Cleanup) ? Cleanup : Status;
+  }
+  return EFI_SUCCESS;
+}
+#endif
