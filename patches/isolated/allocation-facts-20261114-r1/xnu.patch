@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef XNU_ENUMA_ALLOCATION_FACTS_H
+#define XNU_ENUMA_ALLOCATION_FACTS_H
+#include "AllocationFacts.h"
+
+/* Ordinary static kernel storage: no external PA is dereferenced or mapped.
+ * Set only at boot, never published as a device/DMA ownership contract. */
+static volatile ENUMA_ALLOCATION_FACTS enuma_allocation_facts;
+static volatile unsigned int enuma_allocation_facts_consumed;
+
+static void
+enuma_consume_allocation_facts(unsigned long long Base, unsigned long long Bytes)
+{
+  DTEntry Root;
+  void const *Data;
+  unsigned int Length;
+  ENUMA_ALLOCATION_FACTS Snapshot;
+  /* Absent on the normal profile. Presence makes strict validation mandatory. */
+  if (SecureDTLookupEntry(NULL, "/", &Root) != kSuccess)
+    panic("enuma facts: missing ADT root");
+  if (SecureDTGetProperty(Root, ENUMA_FACTS_PROPERTY, &Data, &Length) != kSuccess)
+    return;
+  if (Length != sizeof(Snapshot))
+    panic("enuma facts: length");
+  __builtin_memcpy(&Snapshot,Data,sizeof(Snapshot));
+  if (!EnumaFactsOutsideWindow(&Snapshot,Base,Bytes))
+    panic("enuma facts: invalid or window overlap");
+  enuma_allocation_facts = Snapshot;
+  /* Observable retained copy and explicit consumption; NOT an admission bit. */
+  enuma_allocation_facts_consumed = 1;
+}
+#endif
