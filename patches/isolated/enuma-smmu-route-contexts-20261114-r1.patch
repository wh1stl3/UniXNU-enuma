+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "UfsRouteContextsDiagnostic.h"
+#include <cassert>
+#include <initializer_list>
+struct Reads {
+  unsigned count=0;
+  bool readSmmu(unsigned,bool,uint32_t &raw) { ++count; raw=0; return true; }
+};
+int main() {
+  using namespace ObservedSmmu;
+  Geometry g{};
+  Word ids[]={{true,0x4c017e57},{true,0x6000004a},{true,0x5111}};
+  assert(decodeGeometry(ids[0],ids[1],ids[2],0xd0000,87,g)==Status::Observed);
+  assert(g.pages==128 && g.banks==74 && g.slots==87);
+  for (unsigned missing=0;missing<3;++missing) {
+    ids[missing].read=false;
+    assert(decodeGeometry(ids[0],ids[1],ids[2],0xd0000,87,g)==Status::Unknown);
+    ids[missing].read=true;
+  }
+  assert(decodeGeometry(ids[0],ids[1],ids[2],0x28,87,g)==Status::Incomplete);
+  assert(decodeGeometry(ids[0],ids[1],ids[2],0xd0000,86,g)==Status::Incomplete);
+  Word bad=ids[1]; bad.value|=1U<<31;
+  assert(decodeGeometry(ids[0],bad,ids[2],0xd0000,87,g)==Status::Failure);
+  bad=ids[2]; bad.value=(bad.value&~15U)|6U;
+  assert(decodeGeometry(ids[0],ids[1],bad,0xd0000,87,g)==Status::Failure);
+  for (unsigned bank:{0U,74U,127U,128U}) {
+    UfsWarmCapture capture; Reads r;
+    Geometry shape{87,74,128,15,{36,36,36},0xd0000};
+    Routes routes{{{0xe0,0,7,1},{0x4e0,1,bank,1}},2};
+    assert(!capture.contexts(r,shape,routes) && r.count==0 && capture.count==0);
+  }
+  // Second bank fails the last address, even though all first-bank addresses fit.
+  Geometry shape{87,74,128,15,{36,36,36},(128+11)*4096+3};
+  Routes routes{{{0xe0,0,7,1},{0x4e0,1,11,1}},2};
+  UfsWarmCapture capture; Reads r;
+  assert(!capture.contexts(r,shape,routes) && r.count==0);
+  shape.aperture++;
+  assert(capture.contexts(r,shape,routes) && r.count==6);
+  bool allow[128]={}; allow[7]=allow[11]=true;
+  RecordReader empty{nullptr,0,0}; ObservedBypassIdentity result{};
+  assert(collectAllowedContexts(empty,shape,routes,allow,128,0,0,result)==Status::Unknown);
+  assert(!UfsRouteContexts::Issuer::production(UfsRouteContexts::binding,UfsRouteContexts::session));
+  assert(!UfsRouteContexts::Issuer::issue(UfsRouteContexts::binding,UfsRouteContexts::session,
+    {nullptr,0},UfsReuse::candidateProfile()));
+}
