+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "UfsRouteContextsDiagnostic.h"
+namespace UfsActiveDiagnostic=UfsRouteContexts;
+#include <cassert>
+#include <cstdarg>
+#include <cstdio>
+#include <string>
+#include <vector>
+struct Terminal {};
+struct IOMemoryMap { void retain() {} };
+template<class T> struct OSSharedPtr {
+  T *p=nullptr;
+  explicit operator bool() const { return p; }
+  T *operator->() { return p; }
+};
+static std::vector<unsigned> trace,expected;
+static std::vector<std::string> output;
+static unsigned failAt=999, changeAt=999, maps=0;
+static bool mapOk=true,finished=false;
+static unsigned bank0=7,bank1=11,validCount=2;
+static std::string mode;
+static void IOLog(const char *fmt,...) {
+  assert(trace.empty() || finished);
+  char text[1024]; va_list ap; va_start(ap,fmt);
+  const int n=vsnprintf(text,sizeof(text),fmt,ap); va_end(ap);
+  assert(n>=0 && n<=80); output.emplace_back(text);
+}
+static void IOSleep(unsigned ms) { assert(ms==1500 && (trace.empty() || finished)); }
+static uintptr_t mapPhys(uint64_t base,uint64_t size,OSSharedPtr<IOMemoryMap> &keep) {
+  assert(base==0x15000000 && size==0xd0000); ++maps;
+  static IOMemoryMap m; if (!mapOk) return 0; keep.p=&m; return 0x100000;
+}
+static bool mockReadCompleted() { return trace.size()-1!=failAt; }
+static uint32_t read32(uintptr_t base,unsigned off) {
+  assert(base==0x100000 && !finished);
+  assert(trace.size()<expected.size() && expected[trace.size()]==off);
+  trace.push_back(off); finished=trace.size()==expected.size();
+  uint32_t raw=0;
+  if (off==0x20) raw=0x4c017e57;
+  else if (off==0x24) raw=0x6000004a;
+  else if (off==0x28) raw=0x5111;
+  else if (off>=0x800 && off<=0x958) {
+    unsigned i=(off-0x800)/4;
+    raw=i<validCount?0x80000120+i:0;
+    if (i==0) raw=0x800000e0;
+    if (i==1) raw=0x800004e0;
+    if (mode=="missing" && i==1) raw=0x80000121;
+    if (mode=="mask" && i==0) raw|=1U<<16;
+    if (mode=="duplicate" && i==2) raw=0x800000e0;
+  } else if (off>=0xc00 && off<=0xd58) {
+    unsigned i=(off-0xc00)/4;
+    raw=i==0?bank0:i==1?bank1:(1U<<16);
+    if (mode=="shared" && i==2) raw=bank0;
+    if (mode=="bypass" && i==0) raw|=1U<<16;
+  } else {
+    unsigned b=off==0x1000+4*bank0 || off==0x1800+4*bank0 || off==(128+bank0)*4096?bank0:bank1;
+    if (off==0x1000+4*b) raw=mode=="stage2"?0:1U<<16;
+    else if (off==0x1800+4*b) raw=mode=="va32"?0:1;
+    else { assert(off==(128+b)*4096); raw=mode=="translated"?1:0; }
+  }
+  if (trace.size()-1==changeAt) raw^=1;
+  return raw;
+}
