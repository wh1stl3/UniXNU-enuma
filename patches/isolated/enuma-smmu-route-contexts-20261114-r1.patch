+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef UFS_ROUTE_CONTEXTS_DIAGNOSTIC_H
+#define UFS_ROUTE_CONTEXTS_DIAGNOSTIC_H
+#include "UfsVisibleRoutesReport.h"
+#include "RootWarmCapture.h"
+#ifndef NATIVE_UFS_ENUMA_ROUTE_CONTEXTS_DIAGNOSTIC
+#define NATIVE_UFS_ENUMA_ROUTE_CONTEXTS_DIAGNOSTIC 0
+#endif
+#if NATIVE_UFS_ENUMA_ROUTE_CONTEXTS_DIAGNOSTIC != 0 && NATIVE_UFS_ENUMA_ROUTE_CONTEXTS_DIAGNOSTIC != 1
+#error RouteContexts macro must be 0 or 1
+#endif
+#if NATIVE_UFS_ENUMA_ROUTE_CONTEXTS_DIAGNOSTIC && (NATIVE_UFS_ENUMA_VISIBLE_ROUTES_DIAGNOSTIC || NATIVE_UFS_ENUMA_THREE_ID_DIAGNOSTIC)
+#error RouteContexts requires an independent diagnostic selection
+#endif
+#if defined(UFS_ROUTE_CONTEXTS_HOST_TEST) && (defined(__aarch64__) || defined(__arm64__) || defined(KERNEL))
+#error RouteContexts fixture is host-only, never a target permission
+#endif
+namespace UfsRouteContexts {
+constexpr uint64_t session=0x454e554d41435431ULL;
+constexpr UfsObservation::Binding binding {true,true,false,UfsPlatform::Soc::Sm8250,
+  0x1d84000,0x3000,UfsPlatform::Policy::None,0x15000000,0xd0000,0x20261114};
+constexpr unsigned maxReads=183;
+enum class Result { Denied, BadBinding, AlreadyClaimed, MapFailed, TableFailed,
+                    GeometryRejected, RoutesRejected, ContextFailed, Complete };
+struct Cache : UfsVisibleRoutes::Cache {
+  UfsWarmCapture contexts;
+  ObservedSmmu::Geometry geometry;
+  ObservedSmmu::Routes resolved;
+  ObservedSmmu::ObservedBypassIdentity identity;
+  ObservedSmmuCapture::Breadcrumb contextBreadcrumb;
+  unsigned contextAttempted, contextCompleted;
+  ObservedSmmu::Status geometryStatus, routeStatus, modeStatus;
+  Result contextResult;
+};
+class Session final {
+  friend struct Issuer;
+  constexpr Session() {}
+  Session(const Session &)=delete;
+  Session &operator=(const Session &)=delete;
+public:
+  bool valid(const UfsObservation::Binding &b,uint64_t s) const {
+    return s==session && UfsObservation::sameBinding(b,binding);
+  }
+};
+struct Issuer {
+  // No target success issuer exists, even with the diagnostic macro enabled.
+  __attribute__((noinline)) static const Session *issue(
+      const UfsObservation::Binding &,uint64_t,UfsPlatform::Bytes,
+      UfsReuse::AccessProfile) { return nullptr; }
+  static const Session *production(const UfsObservation::Binding &,uint64_t) { return nullptr; }
+#ifdef UFS_ROUTE_CONTEXTS_HOST_TEST
+  static const Session *approvedFixture() { static constexpr Session s; return &s; }
+#endif
+};
+// Independent one-shot identity. No reset or dependency on an old session claim.
+inline bool claim() {
+  static unsigned consumed;
+  return !__atomic_exchange_n(&consumed,1U,__ATOMIC_ACQ_REL);
+}
+static inline void reset(Cache &c) {
+  UfsVisibleRoutes::reset(c);
+  c.contexts.count=0;
+  for (auto &w:c.contexts.words) w={0,{false,0}};
+  c.geometry={}; c.resolved={}; c.identity={};
+  auto &b=c.contextBreadcrumb;
+  b.sample=0; b.domain=0; b.stage=0; b.offset=0; b.attempted=0; b.completed=0;
+  c.contextAttempted=0; c.contextCompleted=0;
+  c.geometryStatus=c.routeStatus=c.modeStatus=ObservedSmmu::Status::Unknown;
+  c.contextResult=Result::MapFailed;
+}
+// Only adapts the existing bounded Read32 to the unchanged contexts sampler.
+// No mapping, address policy, write, allocation or controller Port is introduced.
+template<class Read32> struct ContextReads {
+  Read32 &read; Cache &cache;
+  bool readSmmu(unsigned offset,bool bank,uint32_t &raw) {
+    ++cache.contextAttempted;
+    const bool ok=ObservedSmmuCapture::markedRead(cache.contextBreadcrumb,0,1,
+      bank?3:2,offset,raw,read);
+    if (ok) ++cache.contextCompleted;
+    return ok;
+  }
+};
+template<class Read32> __attribute__((noinline)) static void capture(Read32 &read,Cache &c) {
+  using namespace ObservedSmmu;
+  // Reuse the exact existing 3 + 87 + VALID-only capture, NOT table().
+  UfsVisibleRoutes::capture(read,c);
+  c.contextResult=Result::TableFailed;
+  if (!c.capture_complete) return;
+  c.geometryStatus=decodeGeometry(c.ids[0],c.ids[1],c.ids[2],
+    binding.smmuSize,UfsVisibleRoutes::slots,c.geometry);
+  c.contextResult=Result::GeometryRejected;
+  if (c.geometryStatus!=Status::Observed) return;
+  // Serialize only cached records for the existing offline decoder.
+  for (unsigned i=0;i<3;++i)
+    c.contexts.words[c.contexts.count++]={UfsVisibleRoutes::idOffsets[i],c.ids[i]};
+  for (unsigned i=0;i<c.table.count;++i) {
+    c.contexts.words[c.contexts.count++]={0x800+4*i,c.table.slots[i].smr};
+    if (UfsVisibleRoutes::legacyValid(c.table.slots[i].smr.value))
+      c.contexts.words[c.contexts.count++]={0xc00+4*i,c.table.slots[i].s2cr};
+  }
+  const uint32_t sids[]={0xe0,0x4e0};
+  c.routeStatus=resolveExactStreams(c.geometry,c.table,sids,2,c.resolved);
+  c.contextResult=Result::RoutesRejected;
+  if (c.routeStatus!=Status::Observed) return;
+  ContextReads<Read32> marked {read,c};
+  c.contextResult=Result::ContextFailed;
+  // contexts() prechecks all six addresses before its first take().
+  if (!c.contexts.contexts(marked,c.geometry,c.resolved)) return;
+  bool allowed[128]={};
+  for (const auto &r:c.resolved.entries) allowed[r.bank]=true;
+  auto records=c.contexts.reader();
+  c.modeStatus=collectAllowedContexts(records,c.geometry,c.resolved,allowed,128,
+    binding.smmuBase,session,c.identity);
+  c.contextResult=Result::Complete;
+}
+template<class Map,class Read32> static Result execute(const Session *permit,
+    const UfsObservation::Binding &b,uint64_t s,Map &map,Read32 &read,Cache &c) {
+  if (!permit) return Result::Denied;
+  if (!permit->valid(b,s)) return Result::BadBinding;
+  if (!claim()) return Result::AlreadyClaimed;
+  reset(c);
+  if (!map(binding.smmuBase,binding.smmuSize)) return c.contextResult;
+  capture(read,c); return c.contextResult;
+}
+}
+#endif
