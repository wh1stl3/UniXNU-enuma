+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Shared bounded sampler. Record/decoder remain unchanged; no SMMU write API.
+struct UfsWarmCapture {
+  ObservedSmmu::Record words[3 + 2*128 + 6] {};
+  unsigned count = 0;
+  template<class Port> bool take (Port &port, unsigned offset, bool bank) {
+    if (count == sizeof (words)/sizeof (words[0])) return false;
+    uint32_t raw = 0;
+    bool completed = port.readSmmu (offset, bank, raw);
+    words[count++] = {offset, {completed, raw}};
+    return completed; // Real synchronous abort is not a returned false.
+  }
+  ObservedSmmu::RecordReader reader () { return {words, count, 0}; }
+  template<class Port> bool table (Port &port, ObservedSmmu::Geometry &geometry,
+                                    ObservedSmmu::Table &visible) {
+    using namespace ObservedSmmu;
+    // Sequential, exactly one 32-bit read per ID before geometry-controlled reads.
+    if (!take (port, 0x20, false) || !take (port, 0x24, false) || !take (port, 0x28, false)) return false;
+    if (decodeGeometry (words[0].word, words[1].word, words[2].word,
+        port.aperture (), port.accessibleSlots (), geometry) != Status::Observed) return false;
+    for (unsigned slot=0; slot<geometry.slots; ++slot) {
+      if (!take (port, 0x800+4*slot, false)) return false;
+      if ((words[count-1].word.value & 0x80000000U) && !take (port, 0xc00+4*slot, false)) return false;
+    }
+    auto r=reader ();
+    return collectVisibleStreams (r, geometry, visible) == Status::Observed;
+  }
+  template<class Port> bool contexts (Port &port, const ObservedSmmu::Geometry &g,
+                                      const ObservedSmmu::Routes &routes) {
+    using namespace ObservedSmmu;
+    if (routes.count != 2) return false;
+    // Validate ALL derived banks/offsets before the FIRST context access.
+    for (const auto &route : routes.entries) {
+      unsigned b=route.bank;
+      if (!b || b>=g.banks || b>=128 ||
+          !inside (0x1000+4*b, g.aperture) || !inside (0x1800+4*b, g.aperture) ||
+          !inside (uint64_t(g.pages+b)*4096, g.aperture)) return false;
+    }
+    for (const auto &route : routes.entries) {
+      unsigned b=route.bank;
+      if (!take (port, 0x1000+4*b, true) || !take (port, 0x1800+4*b, true) ||
+          !take (port, (g.pages+b)*4096, true)) return false;
+    }
+    return true;
+  }
+};
