+  for (unsigned i=0;i<validCount;++i) expected.push_back(0xc00+4*i);
+  const bool routeBad=mode=="missing" || mode=="mask" || mode=="duplicate" ||
+    mode=="shared" || mode=="same-bank" || mode=="bypass";
+  const bool bankBad=mode=="bank0" || mode=="bank-limit";
+  if (!routeBad && !bankBad)
+    for (unsigned b:{bank0,bank1}) {
+      expected.push_back(0x1000+4*b); expected.push_back(0x1800+4*b);
+      expected.push_back((128+b)*4096);
+    }
+  if (failAt<expected.size()) expected.resize(failAt+1);
+  if (changeAt<3) expected.resize(changeAt+1);
+  const auto *permit=UfsRouteContexts::Issuer::approvedFixture();
+  if (mode=="denied") permit=nullptr;
+  auto binding=UfsRouteContexts::binding;
+  if (mode=="bad-binding") ++binding.policyVersion;
+  try { enumaVisibleRoutesExecute(permit,binding); assert(false); } catch (Terminal &) {}
+  if (mode=="denied" || mode=="bad-binding") {
+    assert(maps==0 && trace.empty()); return 0;
+  }
+  assert(maps==1 && (mapOk?trace==expected:trace.empty()));
+  auto &c=gVisibleCache;
+  assert(c.attempted+c.contextAttempted<=183);
+  assert(c.completed+c.contextCompleted+unsigned(failAt<trace.size())==trace.size());
+  if (!mapOk) { assert(c.contextResult==UfsRouteContexts::Result::MapFailed); return 0; }
+  if (failAt<trace.size() || changeAt<3) {
+    assert(!c.capture_complete || c.contextResult==UfsRouteContexts::Result::ContextFailed);
+    assert(c.modeStatus==ObservedSmmu::Status::Unknown);
+  } else if (routeBad) {
+    assert(c.contextAttempted==0 && c.contextResult==UfsRouteContexts::Result::RoutesRejected);
+  } else if (bankBad) {
+    assert(c.contextAttempted==0 && c.contextResult==UfsRouteContexts::Result::ContextFailed);
+  } else {
+    assert(c.contextAttempted==6 && c.contextCompleted==6);
+    assert(c.contextResult==UfsRouteContexts::Result::Complete);
+    const bool badMode=mode=="stage2" || mode=="va32" || mode=="translated";
+    assert(c.modeStatus==(badMode?ObservedSmmu::Status::Failure:ObservedSmmu::Status::Observed));
+  }
+  // All six derived addresses/raw/read bits, including unread suffix, are cached output.
+  if (c.resolved.count==2) {
+    unsigned rows=0;
+    for (const auto &s:output) if (s.rfind("UFSCTX b",0)==0 && s.find(" addr=")!=std::string::npos) ++rows;
+    assert(rows==6);
+  }
+  if (mode=="repeat") {
+    const auto old=trace;
+    try { enumaVisibleRoutesExecute(permit,binding); assert(false); } catch (Terminal &) {}
+    assert(maps==1 && trace==old);
+  }
+  return 0;
+}
