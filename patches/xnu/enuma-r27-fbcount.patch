+{
+	for (auto meta = service->getMetaClass(); meta; meta = meta->getSuperClass()) {
+		const char *name = meta->getClassName();
+		if (strcmp(name, "IOMobileFramebufferLegacy") == 0 ||
+		    strcmp(name, "IOMobileFramebuffer") == 0 ||
+		    strcmp(name, "IOFramebuffer") == 0) {
+			return true;
+		}
+	}
+	return false;
+}
