--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2089,6 +2089,28 @@
  * ENOMEM	shared region is empty
  * EFAULT	bad address for "start_address"
  */
+__attribute__((noinline))
+static void
+enuma_sr_check(int error, bool first)
+{
+	/* One boot-wide stream; -1 makes the first snapshot visible. */
+	static int last = -1;
+	int state = error * 2 + first;
+	if (os_atomic_xchg(&last, state, relaxed) != state) {
+		printf("enuma-sr: check ret=%d first=%u\n", error, (unsigned int)first);
+	}
+}
+
+__attribute__((noinline))
+static void
+enuma_sr_call(uint64_t size, bool slide, int kr)
+{
+	static unsigned int completed;
+	unsigned int n = os_atomic_inc(&completed, relaxed);
+	printf("enuma-sr: call=%u size=0x%llx slide=%u kr=%d\n",
+	    n, (unsigned long long)size, (unsigned int)slide, kr);
+}
+
 int
