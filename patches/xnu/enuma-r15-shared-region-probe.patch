+			/* This is the result of the existing locked first-mapping snapshot. */
+			first = kr == KERN_SUCCESS;
 			if (kr != KERN_SUCCESS) {
 				SHARED_REGION_TRACE_ERROR(("shared_region: %p [%d(%s)] "
 				    "check_np(0x%llx) "
@@ -2185,6 +2210,9 @@
