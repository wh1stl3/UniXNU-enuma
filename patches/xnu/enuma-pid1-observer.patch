+/* Fixed rows and printable-only text avoid wrap/scroll. Each reader batch is
+ * at most 16 characters; transitions revoke and drain under this same lock.
+ * Do not call vcputc (recursive lock), allocate, sleep or retain vinfo here. */
+static void
+enuma_pid1_write(unsigned int row, const char *text)
+{
+	unsigned int length = (unsigned int)strlen(text);
+	for (unsigned int col = 0; col < 96; col += 16) {
+		VCPUTC_LOCK_LOCK();
+		if (!ep_console_can_write(&enuma_pid1_console, gc_enabled) ||
+		    vinfo.v_columns < 100 || vinfo.v_rows < 6 || gc_vt100state != ESnormal) {
+			VCPUTC_LOCK_UNLOCK();
+			return;
+		}
+		unsigned int old_x = gc_x, old_y = gc_y;
+		int old_hanging = gc_hanging_cursor;
+		gc_hide_cursor(gc_x, gc_y);
+		gc_x = col;
+		gc_y = row;
+		gc_hanging_cursor = 0;
+		for (unsigned int i = col; i < col + 16; i++) {
+			gc_putchar(i < length ? text[i] : ' ');
+		}
+		gc_x = old_x;
+		gc_y = old_y;
+		gc_hanging_cursor = old_hanging;
+		gc_show_cursor(gc_x, gc_y);
+		VCPUTC_LOCK_UNLOCK();
+	}
+}
+
+static void
+enuma_pid1_observer(void *parameter __unused, wait_result_t result __unused)
+{
+	struct ep_state *s = &enuma_pid1_state;
+	uint64_t sequence = 0;
+	for (;;) {
+		char line[96];
+		uint32_t first = __atomic_load_n(&s->first.phase, __ATOMIC_ACQUIRE);
+		uint32_t exited = __atomic_load_n(&s->exit.phase, __ATOMIC_ACQUIRE);
+		uint64_t count = __atomic_load_n(&s->svc_count, __ATOMIC_RELAXED);
+		uint32_t started = __atomic_load_n(&s->observer_start, __ATOMIC_ACQUIRE);
+		/* Refresh sequence changes even if SVC count stalls. READY fields are
+		 * immutable; WRITING is reported numerically as pending, never waited on. */
+		snprintf(line, sizeof(line), "P1 REFRESH=%llu SVC=%llu ID=%llu",
+		    (unsigned long long)++sequence, (unsigned long long)count,
+		    (unsigned long long)s->target.uniqueid);
+		enuma_pid1_write(0, line);
+		snprintf(line, sizeof(line), "FIRST=%u PID=%u UID=%llu START=%u RC=%d", first,
+		    first == EP_READY ? s->first.pid : 0,
+		    first == EP_READY ? (unsigned long long)s->first.uniqueid : 0ULL,
+		    started, started == EP_START_RUNNING || started == EP_START_FAILED ||
+		    started == EP_START_SKIPPED ? s->observer_result : 0);
+		enuma_pid1_write(1, line);
+		snprintf(line, sizeof(line), "TRAP=%d PC=%016llX",
+		    first == EP_READY ? s->first.trap : 0,
+		    first == EP_READY ? (unsigned long long)s->first.pc : 0ULL);
+		enuma_pid1_write(2, line);
+		snprintf(line, sizeof(line), "EXIT_COMMITTED=%u WAIT=%d REASON=%u NS=%u CODE=%016llX",
+		    exited, exited == EP_READY ? s->exit.wait_status : 0,
+		    exited == EP_READY ? s->exit.reason_present : 0,
+		    exited == EP_READY ? s->exit.reason_namespace : 0,
+		    exited == EP_READY ? (unsigned long long)s->exit.reason_code : 0ULL);
+		enuma_pid1_write(3, line);
+		/* No console/proc lock is held across the timed blocking wait. */
+		assert_wait_timeout((event_t)s, THREAD_UNINT, 1000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+enuma_pid1_begin(uint32_t pid, uint64_t uniqueid)
+{
+	thread_t observer;
+	if (!ep_begin(&enuma_pid1_state, pid, uniqueid)) {
+		return;
+	}
+	if (!__atomic_load_n(&enuma_pid1_lock_ready, __ATOMIC_ACQUIRE)) {
+		ep_start_complete(&enuma_pid1_state, EP_START_SKIPPED, 0);
+		return;
+	}
+	VCPUTC_LOCK_LOCK();
+	int draw = ep_console_start(&enuma_pid1_console, gc_initialized, gc_enabled);
+	VCPUTC_LOCK_UNLOCK();
+	if (!draw) {
+		ep_start_complete(&enuma_pid1_state, EP_START_SKIPPED, 0);
+		return;
+	}
+	__atomic_store_n(&enuma_pid1_state.observer_start, EP_STARTING, __ATOMIC_RELEASE);
+	kern_return_t kr = kernel_thread_start(enuma_pid1_observer, NULL, &observer);
+	ep_start_complete(&enuma_pid1_state,
+	    kr == KERN_SUCCESS ? EP_START_RUNNING : EP_START_FAILED, kr);
+	if (kr == KERN_SUCCESS) {
+		/* kernel_thread_start uses the normal base priority; no startup failure
+		 * changes PID1 release. Drop the returned caller reference. */
+		thread_deallocate(observer);
+	}
+}
+
+void
+enuma_pid1_svc(uint32_t pid, uint64_t uniqueid, int32_t trap, uint64_t pc)
+{
+	ep_svc(&enuma_pid1_state, pid, uniqueid, trap, pc);
+}
+
+void
+enuma_pid1_exit(uint32_t pid, uint64_t uniqueid, int32_t status,
+    uint32_t present, uint32_t ns, uint64_t code)
+{
+	ep_exit_commit(&enuma_pid1_state, pid, uniqueid, status, present, ns, code);
+}
