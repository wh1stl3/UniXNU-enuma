diff --git a/osfmk/kern/enuma_pid1.h b/osfmk/kern/enuma_pid1.h
new file mode 100644
index 0000000..f33c366
--- /dev/null
+++ b/osfmk/kern/enuma_pid1.h
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef ENUMA_PID1_H
+#define ENUMA_PID1_H
+#include <stdint.h>
+
+/* Device patch only: this build is an enuma RAM-root diagnostic, not acceptance. */
+#define ENUMA_PID1_DIAGNOSTIC 1
+enum { EP_EMPTY, EP_WRITING, EP_READY };
+enum { EP_START_NONE, EP_START_SKIPPED, EP_STARTING, EP_START_RUNNING, EP_START_FAILED };
+struct ep_identity { uint32_t phase, pid; uint64_t uniqueid; };
+struct ep_first {
+	uint32_t phase, pid;
+	uint64_t uniqueid, pc;
+	int32_t trap;
+};
+struct ep_exit {
+	uint32_t phase, reason_present, reason_namespace;
+	int32_t wait_status;
+	uint64_t reason_code;
+};
+struct ep_state {
+	struct ep_identity target;
+	uint32_t observer_start;
+	int32_t observer_result;
+	uint64_t svc_count;
+	struct ep_first first;
+	struct ep_exit exit;
+};
+_Static_assert(__atomic_always_lock_free(8, 0), "64-bit atomics must be inline");
+
+/* Single bootstrap writer. Completion code is immutable after a final state;
+ * readers must acquire a final state before reading it. No printf or retry. */
+static inline void
+ep_start_complete(struct ep_state *s, uint32_t status, int32_t result)
+{
+	s->observer_result = result;
+	__atomic_store_n(&s->observer_start, status, __ATOMIC_RELEASE);
+}
+
+static inline int
+ep_claim(uint32_t *phase)
+{
+	uint32_t empty = EP_EMPTY;
+	/* One attempt only: a busy writer is pending, never waited on. */
+	return __atomic_compare_exchange_n(phase, &empty, EP_WRITING, 0,
+	           __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+}
+
+static inline int
+ep_begin(struct ep_state *s, uint32_t pid, uint64_t uniqueid)
+{
+	if (pid != 1 || !ep_claim(&s->target.phase)) {
+		return 0;
+	}
+	s->target.pid = pid;
+	s->target.uniqueid = uniqueid;
+	__atomic_store_n(&s->target.phase, EP_READY, __ATOMIC_RELEASE);
+	return 1;
+}
+
+static inline int
+ep_matches(const struct ep_state *s, uint32_t pid, uint64_t uniqueid)
+{
+	return __atomic_load_n(&s->target.phase, __ATOMIC_ACQUIRE) == EP_READY &&
+	       s->target.pid == pid && s->target.uniqueid == uniqueid;
+}
+
+static inline void
+ep_svc(struct ep_state *s, uint32_t pid, uint64_t uniqueid, int32_t trap, uint64_t pc)
+{
+	if (!ep_matches(s, pid, uniqueid)) {
+		return;
+	}
+	__atomic_fetch_add(&s->svc_count, 1, __ATOMIC_RELAXED);
+	if (!ep_claim(&s->first.phase)) {
+		return;
+	}
+	s->first.pid = pid;
+	s->first.uniqueid = uniqueid;
+	s->first.trap = trap;
+	s->first.pc = pc;
+	__atomic_store_n(&s->first.phase, EP_READY, __ATOMIC_RELEASE);
+}
+
+static inline void
+ep_exit_commit(struct ep_state *s, uint32_t pid, uint64_t uniqueid,
+    int32_t wait_status, uint32_t present, uint32_t ns, uint64_t code)
+{
+	if (!ep_matches(s, pid, uniqueid) || !ep_claim(&s->exit.phase)) {
+		return;
+	}
+	s->exit.wait_status = wait_status;
+	s->exit.reason_present = present;
+	s->exit.reason_namespace = ns;
+	s->exit.reason_code = code;
+	__atomic_store_n(&s->exit.phase, EP_READY, __ATOMIC_RELEASE);
+}
+
+/* All gate operations are under VCPUTC_LOCK, except pre-lock-init boot setup.
+ * No framebuffer pointer is retained here. A transition lock acquisition drains
+ * the only reader, which holds that same lock for at most 16 characters. */
+struct ep_console_gate {
+	unsigned int seen_mapping, eligible, revoked, started, transitions;
+};
+
+static inline int
+ep_console_enter(struct ep_console_gate *g, int has_info)
+{
+	int first = has_info && !g->seen_mapping;
+	if ((has_info && g->seen_mapping) || g->started) {
+		g->revoked = 1;
+		g->eligible = 0;
+	}
+	if (has_info) {
+		g->seen_mapping = 1;
+	}
+	g->transitions++;
+	return first;
+}
+
+static inline void
+ep_console_leave(struct ep_console_gate *g, int first, int boot_owned_valid)
+{
+	if (first) {
+		if (boot_owned_valid && !g->revoked) {
+			g->eligible = 1;
+		} else {
+			g->revoked = 1;
+		}
+	}
+	g->transitions--;
+}
+
+static inline int
+ep_console_start(struct ep_console_gate *g, int initialized, int enabled)
+{
+	if (!initialized || !enabled || !g->eligible || g->revoked ||
+	    g->started || g->transitions) {
+		return 0;
+	}
+	g->started = 1;
+	return 1;
+}
+
+static inline int
+ep_console_can_write(const struct ep_console_gate *g, int enabled)
+{
+	return g->started && g->eligible && !g->revoked && !g->transitions && enabled;
+}
+
+#ifndef ENUMA_PID1_HOST_TEST
+void enuma_pid1_begin(uint32_t, uint64_t);
+void enuma_pid1_svc(uint32_t, uint64_t, int32_t, uint64_t);
+void enuma_pid1_exit(uint32_t, uint64_t, int32_t, uint32_t, uint32_t, uint64_t);
+#endif
+#endif
